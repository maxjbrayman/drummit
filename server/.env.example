# Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is gitignored; never commit real keys. In production, set these in
# your hosting platform's settings instead.

# Required: Gemini API key from Google AI Studio.
GEMINI_API_KEY=

# Required: Firebase project ID used to verify App Check tokens.
FIREBASE_PROJECT_ID=

# Optional: port to listen on. Hosting platforms usually set this for you.
# PORT=8080

# Optional: Gemini calls allowed at the same time (default 5).
# DETECTION_MAX_CONCURRENT=5

# Optional: scans allowed per UTC day across all users (default 500).
# DETECTION_DAILY_LIMIT=500
